digraph SecondBrainSchema {
  rankdir=LR;
  graph [fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.8];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, color="#5f5e5a"];

  users [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#E6F1FB">
      <tr><td bgcolor="#185FA5"><font color="white"><b>users</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">email</td></tr>
      <tr><td align="left">password_hash</td></tr>
    </table>>];

  profiles [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#E1F5EE">
      <tr><td bgcolor="#0F6E56"><font color="white"><b>profiles</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">user_id (FK)</td></tr>
      <tr><td align="left">name</td></tr>
    </table>>];

  refresh_tokens [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#E6F1FB">
      <tr><td bgcolor="#185FA5"><font color="white"><b>refresh_tokens</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">user_id (FK)</td></tr>
      <tr><td align="left">token_hash</td></tr>
      <tr><td align="left">revoked_at</td></tr>
    </table>>];

  settings [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#E1F5EE">
      <tr><td bgcolor="#0F6E56"><font color="white"><b>settings</b></font></td></tr>
      <tr><td align="left">profile_id (PK/FK)</td></tr>
      <tr><td align="left">timezone</td></tr>
      <tr><td align="left">week_starts_on</td></tr>
    </table>>];

  tasks [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#FAEEDA">
      <tr><td bgcolor="#854F0B"><font color="white"><b>tasks</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">profile_id (FK)</td></tr>
      <tr><td align="left">title</td></tr>
      <tr><td align="left">urgent / important</td></tr>
      <tr><td align="left">due_at</td></tr>
      <tr><td align="left">deleted_at</td></tr>
    </table>>];

  notes [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#FBEAF0">
      <tr><td bgcolor="#993556"><font color="white"><b>notes</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">profile_id (FK)</td></tr>
      <tr><td align="left">content</td></tr>
      <tr><td align="left">tags []</td></tr>
      <tr><td align="left">converted_task_id (FK)</td></tr>
      <tr><td align="left">deleted_at</td></tr>
    </table>>];

  habits [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#EAF3DE">
      <tr><td bgcolor="#3B6D11"><font color="white"><b>habits</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">profile_id (FK)</td></tr>
      <tr><td align="left">title</td></tr>
      <tr><td align="left">target_per_week</td></tr>
      <tr><td align="left">deleted_at</td></tr>
    </table>>];

  habit_logs [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#EAF3DE">
      <tr><td bgcolor="#3B6D11"><font color="white"><b>habit_logs</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">habit_id (FK)</td></tr>
      <tr><td align="left">profile_id (FK)</td></tr>
      <tr><td align="left">log_date</td></tr>
      <tr><td align="left">completed</td></tr>
    </table>>];

  calendar_events [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#EEEDFE">
      <tr><td bgcolor="#534AB7"><font color="white"><b>calendar_events</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">profile_id (FK)</td></tr>
      <tr><td align="left">title</td></tr>
      <tr><td align="left">starts_at / ends_at</td></tr>
      <tr><td align="left">deleted_at</td></tr>
    </table>>];

  reminders [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#FAECE7">
      <tr><td bgcolor="#993C1D"><font color="white"><b>reminders</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">profile_id (FK)</td></tr>
      <tr><td align="left">title / remind_at</td></tr>
      <tr><td align="left">entity_type / entity_id*</td></tr>
      <tr><td align="left">deleted_at</td></tr>
    </table>>];

  bin_entries [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#F1EFE8">
      <tr><td bgcolor="#5F5E5A"><font color="white"><b>bin_entries</b></font></td></tr>
      <tr><td align="left">id (PK)</td></tr>
      <tr><td align="left">profile_id (FK)</td></tr>
      <tr><td align="left">entity_type / entity_id*</td></tr>
      <tr><td align="left">deleted_at / auto_purge_at</td></tr>
    </table>>];

  users -> profiles [label="1:N"];
  users -> refresh_tokens [label="1:N"];
  profiles -> settings [label="1:1"];
  profiles -> tasks [label="1:N"];
  profiles -> notes [label="1:N"];
  profiles -> habits [label="1:N"];
  profiles -> habit_logs [label="1:N"];
  profiles -> calendar_events [label="1:N"];
  profiles -> reminders [label="1:N"];
  profiles -> bin_entries [label="1:N"];
  tasks -> notes [label="converted from\n(nullable FK)" style=dashed];
  habits -> habit_logs [label="1:N"];
  reminders -> tasks [label="*app-enforced\n(not real FK)" style=dotted color="#993C1D"];
  reminders -> habits [style=dotted color="#993C1D"];
  reminders -> calendar_events [style=dotted color="#993C1D"];
  bin_entries -> tasks [label="*app-enforced\n(not real FK)" style=dotted color="#5F5E5A"];
  bin_entries -> notes [style=dotted color="#5F5E5A"];
  bin_entries -> habits [style=dotted color="#5F5E5A"];
}
