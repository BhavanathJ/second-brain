# Copy this file to .env for local development.
# In production, set these same variable names directly in your host environment.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database Selection ---
# Options: sqlite (default, zero-setup local) | supabase (cloud PostgreSQL)
DB_CLIENT=sqlite
SQLITE_DB_PATH=./db/second_brain.sqlite

# --- Supabase / PostgreSQL (Only required if DB_CLIENT=supabase) ---
# Find these in your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT Authentication ---
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-key-at-least-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- CORS ---
# Local frontend URL during development (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5500,http://localhost:3000
